# Electron Builder Configuration
# Generated by SpecKit V2

appId: {{APP_ID}}
productName: {{APP_DISPLAY_NAME}}
copyright: Copyright © {{YEAR}} {{AUTHOR}}

directories:
  buildResources: build
  output: dist

files:
  - "**/*"
  - "!**/*.ts"
  - "!*.code-workspace"
  - "!LICENSE.md"
  - "!package.lock.json"
  - "!.vscode"
  - "!.idea"
  - "!.gitignore"
  - "!README.md"
  - "!.env*"
  - "!src/**/*.test.js"
  - "!src/**/*.spec.js"

# macOS
mac:
  category: {{MAC_CATEGORY}}
  icon: {{ICON_PATH}}
  target:
    {{#each MAC_TARGETS}}
    - target: {{this}}
      arch:
        {{#each MAC_ARCH}}
        - {{this}}
        {{/each}}
    {{/each}}
  hardenedRuntime: true
  gatekeeperAssess: false
  entitlements: build/entitlements.mac.plist
  entitlementsInherit: build/entitlements.mac.plist

dmg:
  title: {{APP_DISPLAY_NAME}}
  icon: {{ICON_PATH}}
  background: build/background.png
  contents:
    - x: 130
      y: 220
    - x: 410
      y: 220
      type: link
      path: /Applications

# Windows
win:
  icon: {{ICON_PATH}}
  target:
    {{#each WIN_TARGETS}}
    - target: {{this}}
      arch:
        {{#each WIN_ARCH}}
        - {{this}}
        {{/each}}
    {{/each}}

nsis:
  oneClick: false
  perMachine: false
  allowToChangeInstallationDirectory: true
  deleteAppDataOnUninstall: true
  createDesktopShortcut: always
  createStartMenuShortcut: true
  shortcutName: {{APP_DISPLAY_NAME}}
  installerIcon: {{ICON_PATH}}
  uninstallerIcon: {{ICON_PATH}}
  installerHeader: build/installer-header.bmp
  installerSidebar: build/installer-sidebar.bmp

portable:
  artifactName: ${productName}-${version}-portable.exe

# Linux
linux:
  icon: {{ICON_PATH}}
  category: {{LINUX_CATEGORY}}
  target:
    {{#each LINUX_TARGETS}}
    - target: {{this}}
      arch:
        {{#each LINUX_ARCH}}
        - {{this}}
        {{/each}}
    {{/each}}
  synopsis: {{APP_DESCRIPTION}}
  description: {{APP_DESCRIPTION}}
  vendor: {{AUTHOR}}
  maintainer: {{AUTHOR_EMAIL}}

deb:
  depends:
    - libgtk-3-0
    - libnotify4
    - libnss3
    - libxtst6
    - xdg-utils

appImage:
  license: LICENSE

# Auto-update (optional)
{{#if AUTO_UPDATE}}
publish:
  provider: github
  owner: {{GITHUB_OWNER}}
  repo: {{GITHUB_REPO}}
  releaseType: release
{{/if}}

# Compression
compression: normal

# Artifact naming
artifactName: ${productName}-${version}-${os}-${arch}.${ext}
