// Electron Main Process
// Generated by SpecKit V2

const { app, BrowserWindow, ipcMain } = require('electron');
const path = require('path');
const isDev = process.env.NODE_ENV === 'development';

let mainWindow;

function createWindow() {
  mainWindow = new BrowserWindow({
    width: {{WINDOW_WIDTH}},
    height: {{WINDOW_HEIGHT}},
    minWidth: {{MIN_WIDTH}},
    minHeight: {{MIN_HEIGHT}},
    icon: path.join(__dirname, '{{ICON_PATH}}'),
    webPreferences: {
      nodeIntegration: false,
      contextIsolation: true,
      enableRemoteModule: false,
      preload: path.join(__dirname, 'preload.js')
    },
    {{#if FRAMELESS}}
    frame: false,
    {{/if}}
    {{#if TRANSPARENT}}
    transparent: true,
    {{/if}}
    show: false // 先隱藏，等載入完再顯示
  });

  // 載入應用
  if (isDev) {
    mainWindow.loadURL('http://localhost:{{DEV_PORT}}');
    mainWindow.webContents.openDevTools();
  } else {
    mainWindow.loadFile(path.join(__dirname, '{{BUILD_OUTPUT}}/index.html'));
  }

  // 載入完成後顯示視窗
  mainWindow.once('ready-to-show', () => {
    mainWindow.show();
  });

  // 視窗關閉
  mainWindow.on('closed', () => {
    mainWindow = null;
  });
}

// App 準備就緒
app.whenReady().then(() => {
  createWindow();

  app.on('activate', () => {
    // macOS: 點擊 Dock icon 時重新建立視窗
    if (BrowserWindow.getAllWindows().length === 0) {
      createWindow();
    }
  });
});

// 所有視窗關閉
app.on('window-all-closed', () => {
  // macOS: 除非使用者按 Cmd+Q，否則保持 app 運行
  if (process.platform !== 'darwin') {
    app.quit();
  }
});

{{#if SINGLE_INSTANCE}}
// 確保只有一個實例運行
const gotTheLock = app.requestSingleInstanceLock();

if (!gotTheLock) {
  app.quit();
} else {
  app.on('second-instance', (event, commandLine, workingDirectory) => {
    // 當嘗試啟動第二個實例時，聚焦到現有視窗
    if (mainWindow) {
      if (mainWindow.isMinimized()) mainWindow.restore();
      mainWindow.focus();
    }
  });
}
{{/if}}

{{#if FILE_SYSTEM_ACCESS}}
// IPC: 檔案系統操作
ipcMain.handle('read-file', async (event, filePath) => {
  const fs = require('fs').promises;
  try {
    const data = await fs.readFile(filePath, 'utf8');
    return { success: true, data };
  } catch (error) {
    return { success: false, error: error.message };
  }
});

ipcMain.handle('write-file', async (event, filePath, data) => {
  const fs = require('fs').promises;
  try {
    await fs.writeFile(filePath, data, 'utf8');
    return { success: true };
  } catch (error) {
    return { success: false, error: error.message };
  }
});
{{/if}}

{{#if NOTIFICATIONS}}
// IPC: 通知
ipcMain.handle('show-notification', async (event, options) => {
  const { Notification } = require('electron');
  const notification = new Notification({
    title: options.title,
    body: options.body,
    icon: options.icon
  });
  notification.show();
  return { success: true };
});
{{/if}}

{{#if AUTO_UPDATE}}
// 自動更新
const { autoUpdater } = require('electron-updater');

autoUpdater.on('update-available', () => {
  mainWindow.webContents.send('update-available');
});

autoUpdater.on('update-downloaded', () => {
  mainWindow.webContents.send('update-downloaded');
});

ipcMain.handle('check-for-updates', async () => {
  try {
    const result = await autoUpdater.checkForUpdates();
    return { success: true, updateInfo: result.updateInfo };
  } catch (error) {
    return { success: false, error: error.message };
  }
});

ipcMain.handle('install-update', async () => {
  autoUpdater.quitAndInstall();
});

// App 啟動後檢查更新
app.on('ready', () => {
  if (!isDev) {
    setTimeout(() => {
      autoUpdater.checkForUpdates();
    }, 5000);
  }
});
{{/if}}

// 錯誤處理
process.on('uncaughtException', (error) => {
  console.error('Uncaught Exception:', error);
  // 可以在這裡記錄錯誤到檔案或發送到錯誤追蹤服務
});
