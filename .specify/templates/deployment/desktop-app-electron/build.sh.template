#!/bin/bash
# Electron App Build Script
# Generated by SpecKit V2

set -e

echo "🔨 Building Electron App: {{APP_NAME}}"
echo "========================================"

# Check Node.js and npm
if ! command -v node &> /dev/null; then
  echo "❌ Error: Node.js not installed"
  echo "Install from: https://nodejs.org/"
  exit 1
fi

if ! command -v npm &> /dev/null; then
  echo "❌ Error: npm not installed"
  exit 1
fi

echo "✅ Node.js $(node -v)"
echo "✅ npm $(npm -v)"
echo ""

# Install dependencies if needed
if [ ! -d "node_modules" ]; then
  echo "📦 Installing dependencies..."
  npm install
  echo "✅ Dependencies installed"
else
  echo "✅ Dependencies already installed"
fi
echo ""

# Build web app first
echo "🔨 Building web application..."
npm run build
echo "✅ Web app built"
echo ""

# Build for all platforms or specific platform
PLATFORM="${1:-all}"

case "$PLATFORM" in
  windows)
    echo "🪟 Building for Windows..."
    npm run electron:build:win
    ;;

  mac)
    echo "🍎 Building for macOS..."
    npm run electron:build:mac
    ;;

  linux)
    echo "🐧 Building for Linux..."
    npm run electron:build:linux
    ;;

  all)
    echo "🌐 Building for all platforms..."

    # Check OS for platform-specific builds
    OS="$(uname)"

    if [ "$OS" = "Darwin" ]; then
      echo "Current OS: macOS"
      echo "Building: macOS, Windows, Linux"
      npm run electron:build
    elif [ "$OS" = "Linux" ]; then
      echo "Current OS: Linux"
      echo "Building: Linux, Windows"
      echo "⚠️  Note: Cannot build macOS on Linux"
      npm run electron:build:linux
      npm run electron:build:win
    else
      echo "Current OS: Windows"
      echo "Building: Windows"
      echo "⚠️  Note: Building other platforms on Windows requires additional setup"
      npm run electron:build:win
    fi
    ;;

  *)
    echo "❌ Unknown platform: $PLATFORM"
    echo "Usage: ./build.sh [windows|mac|linux|all]"
    exit 1
    ;;
esac

echo ""
echo "========================================"
echo "✅ Build Complete!"
echo "========================================"
echo ""

# List output files
if [ -d "dist" ]; then
  echo "📦 Built files:"
  echo ""
  find dist -maxdepth 1 -type f \( -name "*.exe" -o -name "*.dmg" -o -name "*.deb" -o -name "*.AppImage" -o -name "*.rpm" \) -exec ls -lh {} \;
  echo ""

  # Calculate total size
  TOTAL_SIZE=$(find dist -maxdepth 1 -type f \( -name "*.exe" -o -name "*.dmg" -o -name "*.deb" -o -name "*.AppImage" -o -name "*.rpm" \) -exec stat -f%z {} \; 2>/dev/null | awk '{s+=$1} END {print s}' || find dist -maxdepth 1 -type f \( -name "*.exe" -o -name "*.dmg" -o -name "*.deb" -o -name "*.AppImage" -o -name "*.rpm" \) -exec stat -c%s {} \; 2>/dev/null | awk '{s+=$1} END {print s}')

  if [ -n "$TOTAL_SIZE" ]; then
    TOTAL_SIZE_MB=$(echo "scale=2; $TOTAL_SIZE / 1024 / 1024" | bc)
    echo "📊 Total size: ${TOTAL_SIZE_MB} MB"
  fi
fi

echo ""
echo "🚀 Next steps:"
echo "1. Test installers on target platforms"
echo "2. Sign installers (optional, recommended for distribution)"
echo "3. Distribute via GitHub Releases, website, or app stores"
echo ""
echo "📄 Distribution guide: deployment/README.md"
