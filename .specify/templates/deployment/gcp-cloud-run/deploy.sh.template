#!/bin/bash
# GCP Cloud Run Deployment Script
# Generated by SpecKit V2

set -e

echo "🚀 Deploying to GCP Cloud Run"
echo "========================================"

# Configuration
PROJECT_ID="{{PROJECT_ID}}"
REGION="{{REGION}}"
SERVICE_NAME="{{SERVICE_NAME}}"

# Check if gcloud is installed
if ! command -v gcloud &> /dev/null; then
  echo "❌ Error: gcloud CLI not installed"
  echo ""
  echo "Install from: https://cloud.google.com/sdk/docs/install"
  exit 1
fi

echo "✅ gcloud CLI found"

# Check authentication
CURRENT_PROJECT=$(gcloud config get-value project 2>/dev/null)

if [ -z "$CURRENT_PROJECT" ]; then
  echo "⚠️  Not authenticated with gcloud"
  echo "Logging in..."
  gcloud auth login
fi

echo "Current project: $CURRENT_PROJECT"

# Set project
if [ "$CURRENT_PROJECT" != "$PROJECT_ID" ]; then
  echo "Switching to project: $PROJECT_ID"
  gcloud config set project "$PROJECT_ID"
fi

# Check if required APIs are enabled
echo ""
echo "🔍 Checking required APIs..."

REQUIRED_APIS=(
  "cloudbuild.googleapis.com"
  "run.googleapis.com"
  "containerregistry.googleapis.com"
)

for api in "${REQUIRED_APIS[@]}"; do
  if gcloud services list --enabled --filter="name:$api" --format="value(name)" | grep -q "$api"; then
    echo "✅ $api"
  else
    echo "⚠️  $api not enabled"
    echo "Enabling $api..."
    gcloud services enable "$api"
    echo "✅ $api enabled"
  fi
done

echo ""
echo "========================================"
echo "Deployment Configuration"
echo "========================================"
echo "Project:      $PROJECT_ID"
echo "Region:       $REGION"
echo "Service:      $SERVICE_NAME"
{{#if MIN_INSTANCES}}
echo "Min Instances: {{MIN_INSTANCES}}"
{{/if}}
{{#if MAX_INSTANCES}}
echo "Max Instances: {{MAX_INSTANCES}}"
{{/if}}
{{#if CPU}}
echo "CPU:          {{CPU}}"
{{/if}}
{{#if MEMORY}}
echo "Memory:       {{MEMORY}}"
{{/if}}
echo "========================================"
echo ""

# Confirm deployment
read -p "Continue with deployment? (y/n) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
  echo "Deployment cancelled"
  exit 1
fi

echo ""
echo "📦 Starting Cloud Build..."
echo ""

# Submit build to Cloud Build
gcloud builds submit \
  --config=deployment/cloudbuild.yaml \
  --substitutions=COMMIT_SHA="$(git rev-parse --short HEAD)" \
  .

BUILD_EXIT_CODE=$?

echo ""
echo "========================================"

if [ $BUILD_EXIT_CODE -eq 0 ]; then
  echo "✅ Deployment successful!"
  echo "========================================"
  echo ""

  # Get service URL
  SERVICE_URL=$(gcloud run services describe "$SERVICE_NAME" \
    --region="$REGION" \
    --format="value(status.url)")

  echo "🌐 Service URL: $SERVICE_URL"
  echo ""

  # Test health check
  {{#if HEALTH_CHECK_PATH}}
  echo "🔍 Testing health check..."
  HEALTH_URL="$SERVICE_URL{{HEALTH_CHECK_PATH}}"

  if curl -f -s "$HEALTH_URL" > /dev/null; then
    echo "✅ Health check passed"
  else
    echo "⚠️  Health check failed"
    echo "URL: $HEALTH_URL"
  fi
  {{/if}}

  echo ""
  echo "📊 Service Details:"
  gcloud run services describe "$SERVICE_NAME" \
    --region="$REGION" \
    --format="table(status.url, status.latestReadyRevisionName, spec.template.spec.containers[0].image)"

  echo ""
  echo "📝 Next steps:"
  echo "1. Test the service: curl $SERVICE_URL"
  {{#if HEALTH_CHECK_PATH}}
  echo "2. Check health: curl $SERVICE_URL{{HEALTH_CHECK_PATH}}"
  {{/if}}
  echo "3. View logs: gcloud logging read \"resource.type=cloud_run_revision AND resource.labels.service_name=$SERVICE_NAME\" --limit 50"
  echo "4. Monitor: https://console.cloud.google.com/run/detail/$REGION/$SERVICE_NAME"

else
  echo "❌ Deployment failed"
  echo "========================================"
  echo ""
  echo "Check build logs:"
  echo "https://console.cloud.google.com/cloud-build/builds"
  echo ""
  echo "Or run: gcloud builds list --limit=1"
  exit 1
fi
